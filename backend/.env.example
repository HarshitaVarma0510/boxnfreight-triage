# Gemini API Failover Pool Configuration
# Option 1: Comma-separated list of keys
GEMINI_API_KEYS=your_primary_key_here,your_secondary_key_here

# Option 2: Individual prioritized keys
# GEMINI_API_KEY_PRIMARY=your_primary_key_here
# GEMINI_API_KEY_SECONDARY=your_secondary_key_here
# GEMINI_API_KEY_TERTIARY=your_tertiary_key_here

# Legacy fallback key
# GEMINI_API_KEY=your_key_here

